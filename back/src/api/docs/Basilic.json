                            "items": {
                                "$ref": "#/definitions/polygon"
                            }
                        }
                    }
                }
            ],
            "position": {
                "description": "A single position",
                "type": "array",
                "minItems": 2,
                "items": [
                    {
                        "type": "number"
                    },
                    {
                        "type": "number"
